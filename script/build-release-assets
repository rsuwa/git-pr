#!/usr/bin/env bash

set -euo pipefail
set +f
export LC_ALL=C
umask 022
unset CDPATH GLOBIGNORE
shopt -u dotglob failglob nocaseglob nocasematch nullglob

usage() {
  printf 'Usage: %s <destination-directory>\n' "${0##*/}" >&2
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum < "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 < "$1" | awk '{print $1}'
  else
    die "Missing command: sha256sum or shasum"
  fi
}

directory_is_empty() {
  local entry

  for entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    if [ -e "$entry" ] || [ -L "$entry" ]; then
      return 1
    fi
  done
  return 0
}

if [ "$#" -ne 1 ] || [ -z "${1-}" ]; then
  usage
  exit 64
fi

destination="$1"
case "$destination" in
  -*)
    die "Destination must not start with '-': $destination"
    ;;
esac

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd "$script_dir/.." && pwd -P)
source_checker="$repo_root/script/build-git-pr"

if [ -L "$source_checker" ] || [ ! -f "$source_checker" ] \
  || [ ! -x "$source_checker" ]; then
  die "Source assembly checker is not a non-symlink regular executable: $source_checker"
fi
if ! "$source_checker" --check; then
  die "Source assembly check failed; refusing to stage release assets."
fi

mkdir -p "$destination" || die "Failed to create release directory: $destination"
release_dir=$(cd "$destination" && pwd -P) || die "Failed to resolve release directory: $destination"

[ "$release_dir" != "$repo_root" ] || die "Release directory must not be the repository root."
if [ ! -r "$release_dir" ] || [ ! -x "$release_dir" ]; then
  die "Release directory must be readable and searchable: $release_dir"
fi
if ! directory_is_empty "$release_dir"; then
  die "Release directory must be empty: $release_dir"
fi

for asset in git-pr install.sh; do
  source_path="$repo_root/$asset"
  if [ -L "$source_path" ] || [ ! -f "$source_path" ]; then
    die "Release source is not a regular file: $source_path"
  fi
done

cp "$repo_root/git-pr" "$release_dir/git-pr"
cp "$repo_root/install.sh" "$release_dir/install.sh"
chmod 755 "$release_dir/git-pr" "$release_dir/install.sh"

git_pr_sha=$(sha256_file "$release_dir/git-pr")
install_sha=$(sha256_file "$release_dir/install.sh")
printf '%s  git-pr\n%s  install.sh\n' "$git_pr_sha" "$install_sha" \
  > "$release_dir/SHA256SUMS"
chmod 644 "$release_dir/SHA256SUMS"

printf 'Built release assets in %s\n' "$release_dir"
